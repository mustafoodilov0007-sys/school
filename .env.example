# ============================================================
# Physics Exam Pro — muhit o'zgaruvchilari namunasi
# Bu faylni `.env` ga nusxalang va QIYMATLARNI O'ZINGIZ to'ldiring.
# Haqiqiy token/parollarni hech qachon repozitoriyga kiritmang.
# ============================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Reverse-proxy (Caddy/nginx) orqasida 1 qo'ying, to'g'ridan-to'g'ri ochiq bo'lsa 0
TRUST_PROXY=0

# --- PostgreSQL ---
# Lokal: docker compose up -d db  (docker-compose.yml dagi qiymatlar bilan mos)
DATABASE_URL=postgresql://pep:CHANGE_ME_DB_PASSWORD@localhost:5432/physics_exam?schema=public
POSTGRES_USER=pep
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=physics_exam

# --- Telegram ---
# @BotFather dan olingan token
BOT_TOKEN=
# Bot username (@ belgisisiz)
BOT_USERNAME=
# O'qituvchi(lar)ning Telegram ID raqamlari, vergul bilan. Admin huquqining YAGONA manbasi.
ADMIN_TELEGRAM_IDS=

# --- Ichki aloqa (bot -> api) ---
# Kamida 32 belgi. Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
API_INTERNAL_URL=http://localhost:3000

# --- Frontend manzillari ---
# Telegram Mini App uchun HTTPS majburiy (productionda ham, BotFather sozlashda ham)
STUDENT_APP_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
# Brauzer Origin'lari, vergul bilan (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Sessiya va xavfsizlik ---
STUDENT_SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8
# Mini App initData eskirish muddati (soniya). Qisqa tuting.
INITDATA_MAX_AGE_SECONDS=900
# Admin kirish havolasi amal qilish muddati (soniya)
ADMIN_LOGIN_TOKEN_TTL_SECONDS=300

# --- O'quvchi ID formati ---
STUDENT_CODE_PREFIX=PH
# Oxirgi qism raqamlari soni (4..8). Xavfsizlik uchun 6 tavsiya etiladi (docs/ARCHITECTURE.md §6)
STUDENT_CODE_SUFFIX_LENGTH=4

# --- Faqat dasturlash uchun (productionda ISHLAMAYDI) ---
# true bo'lsa Mini App Telegramsiz brauzerda DEV foydalanuvchi bilan ochiladi.
# NODE_ENV=production bilan birga true bo'lsa server ishga tushmaydi.
ALLOW_DEV_AUTH=false
DEV_STUDENT_TELEGRAM_ID=

# --- Bot rejimi ---
# polling: lokal ishlab chiqish; webhook: production (HTTPS domen kerak)
BOT_MODE=polling
BOT_PORT=3100
# webhook rejimida: https://bot.example.uz/telegram  (to'liq URL)
BOT_WEBHOOK_URL=
# webhook maxfiy sarlavhasi (A-Z a-z 0-9 _ -), 24+ belgi
BOT_WEBHOOK_SECRET=

# --- Production domenlari (docker compose --profile full; Caddy HTTPS ni o'zi oladi) ---
# Productionda STUDENT_APP_URL=https://$STUDENT_DOMAIN, ADMIN_WEB_URL=https://$ADMIN_DOMAIN,
# BOT_WEBHOOK_URL=https://$STUDENT_DOMAIN/telegram-webhook, BOT_MODE=webhook
STUDENT_DOMAIN=
ADMIN_DOMAIN=
